// Configured by CMake, which fills in the absolute resource paths. Both
// windres (MinGW-w64) and rc.exe (MSVC) compile it. The manifest is embedded
// here for both toolchains; the MSVC link is told not to add its own.

#include <windows.h>
#include <commctrl.h>
#include "resource.h"

CREATEPROCESS_MANIFEST_RESOURCE_ID RT_MANIFEST "@GEIST_W32_MANIFEST@"
IDI_APP ICON "@GEIST_W32_ICON@"
IDR_STYLESHEET RCDATA "@GEIST_W32_CSS@"
IDR_IE_STYLESHEET RCDATA "@GEIST_W32_IE_CSS@"
IDR_LICENSE RCDATA "@GEIST_W32_NOTICES@"

VS_VERSION_INFO VERSIONINFO
FILEVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
PRODUCTVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
FILESUBTYPE VFT2_UNKNOWN
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "CompanyName", "Yvan Janssens"
      VALUE "FileDescription", "Geist BOO Reader"
      VALUE "FileVersion", "@PROJECT_VERSION@ (@GEIST_GIT_REVISION@)"
      VALUE "InternalName", "geist-boo-reader"
      VALUE "LegalCopyright", "Copyright 2026 Yvan Janssens. Apache-2.0."
      VALUE "OriginalFilename", "geist-boo-reader.exe"
      VALUE "ProductName", "Geist BOO Reader"
      VALUE "ProductVersion", "@PROJECT_VERSION@"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END

IDD_SETTINGS DIALOGEX 0, 0, 272, 150
STYLE DS_SHELLFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Geist BOO Reader Settings"
FONT 9, "Segoe UI", 0, 0, 0x1
BEGIN
  LTEXT "Font family:", -1, 12, 16, 70, 10
  COMBOBOX IDC_FONT_FAMILY, 88, 14, 172, 160, CBS_DROPDOWNLIST | CBS_SORT | WS_VSCROLL | WS_TABSTOP
  LTEXT "Contents size:", -1, 12, 36, 70, 10
  COMBOBOX IDC_TOC_SIZE, 88, 34, 60, 160, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
  LTEXT "Topic size:", -1, 12, 56, 70, 10
  COMBOBOX IDC_TOPIC_SIZE, 88, 54, 60, 160, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
  GROUPBOX "File association", -1, 8, 76, 256, 46
  LTEXT "", IDC_ASSOCIATION_STATE, 16, 88, 240, 10
  PUSHBUTTON "&Open .boo Files with This Reader", IDC_REGISTER, 16, 102, 150, 14
  PUSHBUTTON "&Remove", IDC_UNREGISTER, 172, 102, 84, 14
  DEFPUSHBUTTON "Close", IDOK, 210, 130, 54, 14
END

IDD_PROGRESS DIALOGEX 0, 0, 260, 76
STYLE DS_SHELLFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION
CAPTION "Preparing Book for Printing"
FONT 9, "Segoe UI", 0, 0, 0x1
BEGIN
  LTEXT "", IDC_PROGRESS_TEXT, 12, 12, 236, 10
  CONTROL "", IDC_PROGRESS_BAR, PROGRESS_CLASS, WS_BORDER, 12, 28, 236, 10
  PUSHBUTTON "Cancel", IDCANCEL, 194, 52, 54, 14
END

IDD_INFORMATION DIALOGEX 0, 0, 320, 200
STYLE DS_SHELLFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Book Information"
FONT 9, "Segoe UI", 0, 0, 0x1
BEGIN
  DEFPUSHBUTTON "Done", IDOK, 254, 178, 54, 14
END

IDD_LICENSES DIALOGEX 0, 0, 380, 260
STYLE DS_SHELLFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Licences"
FONT 9, "Segoe UI", 0, 0, 0x1
BEGIN
  EDITTEXT IDC_LICENSE_TEXT, 8, 8, 364, 222, ES_MULTILINE | ES_READONLY | WS_VSCROLL | ES_AUTOVSCROLL
  DEFPUSHBUTTON "Close", IDOK, 318, 238, 54, 14
END
