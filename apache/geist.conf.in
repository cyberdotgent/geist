# mod_geist: browse IBM BookManager BOO books over HTTP.
#
# A book is served from its own path, so a book at /var/www/html/packet.boo
# is reached at /packet.boo, with /topic/<id>, /object/<id> and /download
# below it.
<IfModule geist_module>
    # Hand .boo files to the module. It also recognises them by name, so this
    # is here to make the binding explicit and overridable rather than
    # because it is required.
    AddHandler geist-book .boo

    # Offer the BOO file itself for download.
    # Override per directory or per file, including in .htaccess where
    # AllowOverride permits it.
    GeistDownload On

    # auto follows the browser's colour scheme; light and dark pin it.
    GeistTheme auto

    # The module reports its version in a page footer and in the Server
    # header. On says nothing in either place; ServerTokens Prod suppresses
    # every component including this one.
    HideVersion Off

    # Off by default: listing a directory of books publishes the name and
    # title of every book in it, which is the operator's call to make. Turn it
    # on for the directories that hold a shelf:
    #
    #   <Directory /var/www/html/books>
    #       BooIndex On
    #   </Directory>
    #
    # The shelf is named by the first line of a `.title` file beside the
    # books, and headed "Book Index of /path" when there is none; set
    # BooIndexTitle to pin a name in the configuration instead.
    #
    # A real DirectoryIndex file still wins, and a directory with no books is
    # left to mod_autoindex.
    #
    # A large shelf costs about 2 ms per book on its first request, per child
    # process. BooIndexPreload pays it once at startup instead, in the parent,
    # so every child inherits the result. Server configuration only:
    #
    #   BooIndexPreload /var/www/html/books
    BooIndex Off
</IfModule>
