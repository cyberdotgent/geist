                                 no page break within entry -->

<!--
E-1.    ELEMENT Table
-->

<!ELEMENT %tblelm; - O (%tblmdl;) %tblexpt; >

<!ATTLIST Table
  tocentry   %yesorno; #IMPLIED
--shortentry %yesorno; #IMPLIED --
  frame      (top|bottom|topbot|all|sides|none)
                       #IMPLIED -- recommend "all" --
  colsep     %yesorno; #IMPLIED     -- recommend 1 --
  rowsep     %yesorno; #IMPLIED     -- recommend 1 --
  %tblatt;
  %bodyatt;
  %secur; >

<!--
E-2.   ELEMENT tgroup
-->

<!ELEMENT tgroup - o (%tblgrp;) >

<!ATTLIST tgroup
  cols       NUMBER    #REQUIRED
  %tblgrpatt;
  colsep     %yesorno; #IMPLIED -- from table --
  rowsep     %yesorno; #IMPLIED -- from table --
  align      (left|right|center|justify|char) "left"
  charoff    NUTOKEN   "50"
  char       CDATA     ""
  %secur; >

<!--
E-3.  ELEMENT colspec
-->

<!ELEMENT colspec - o EMPTY >

<!ATTLIST colspec
  colnum     NUMBER    #IMPLIED
  colname    NMTOKEN   #IMPLIED
  align      (left|right|center|justify|char)
                       #IMPLIED -- from tgroup --
  charoff    NUTOKEN   #IMPLIED  -- from tgroup --
  char       CDATA     #IMPLIED       -- from tgroup --
  colwidth   CDATA     #IMPLIED
  colsep     %yesorno; #IMPLIED -- from tgroup --
  rowsep     %yesorno; #IMPLIED -- from tgroup --
>

<!--
F4.  ELEMENT spanspec
-->

<!ELEMENT spanspec - o EMPTY >

<!ATTLIST spanspec
  namest     NMTOKEN   #REQUIRED
  nameend    NMTOKEN   #REQUIRED
  spanname   NMTOKEN   #REQUIRED
  align (left|right|center|justify|char)
                       #IMPLIED
  charoff    NUTOKEN   #IMPLIED
  char       CDATA     #IMPLIED
  colsep     %yesorno; #IMPLIED
  rowsep     %yesorno; #IMPLIED
>

<!--
E-5.  ELEMENT (thead|tfoot)
-->

<!ELEMENT %tblhdft; - o (%tblhfmd;)  %tblhfex;>

<!ATTLIST %tblhdft;
  valign     (top|middle|bottom)
                       #IMPLIED
  %secur;
>

<!--
E-6.  ELEMENT tbody
-->

<!ELEMENT tbody - o (row+)>

<!ATTLIST tbody
  valign     (top|middle|bottom)
                       #IMPLIED
  %secur;
>

<!--
E-7 ELEMENT row
-->

<!ELEMENT row - o (%tblrow;)+ %tblrowex;>

<!ATTLIST row
  rowsep     %yesorno; #IMPLIED -- from tgroup --
  valign     (top|middle|bottom)
                       #IMPLIED
  %secur;
>

<!--
E-9.  ELEMENT entry
-->

<!ELEMENT entry - o %tblcon; %tblconex; >

<!ATTLIST entry
  colname    NMTOKEN   #IMPLIED  -- colname from colspec --
  namest     NMTOKEN   #IMPLIED   -- colname from colspec --
