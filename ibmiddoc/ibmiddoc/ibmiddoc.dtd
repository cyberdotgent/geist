<!ELEMENT  IBMIDDoc         O O (%DocumentElement;) +(DVCFObj) >
<!-- Add DTDVersion attribute with DTD version in content  WLW V4.0.7 -->
<!-- Add DocStyle attribute                                Sim V4.3.0 -->
<!-- Add Company attribute                                 Sim V4.3.0 -->
<!-- Add MLSprefix attribute                               Sim V4.3.0 -->
<!-- Add PageNumber, PartPrefix, ChapPrefix, AppPrefix     Sim V4.3.2 -->
<!-- Add Classif                                           Sim V4.3.2 -->
<!-- Add MaxTOC                                            Sim V4.3.4 -->
<!-- Add MultiVol                                          Sim V4.3.4 -->
<!-- Add Brand and NewBrand                                Sim V4.3.5 -->
<!ATTLIST  IBMIDDoc
    Class            NAME         #IMPLIED
    Company          NAME         #IMPLIED
    Copyr            IDREFS       #IMPLIED
    DocStyle         NAME         #IMPLIED
    IBMCopyr         CDATA        #IMPLIED
    ID               ID           #IMPLIED
    Language         NAME         #IMPLIED
    MaxTOC           NUMBER       #IMPLIED
    MLSprefix        (Prefix | NoPrefix)
                                  #IMPLIED
    Multivol         (OneVol | Index-Folio)
                                  #IMPLIED
    Props            CDATA        #IMPLIED
    Rev              IDREFS       #IMPLIED
    IBMSec           (UNC | IC)   #IMPLIED
    Sec              CDATA        #IMPLIED
    Status           (New | Changed | Deleted | Unchanged)
                                  #IMPLIED
    Style            CDATA        #IMPLIED
    XRefText         CDATA        #IMPLIED
    Brand            (Default-Brand | eserver-white | eserver-black | NewBrand)
                                  #IMPLIED
    NewBrand         NAME         #IMPLIED
    PageNumber       (Default-Folio | Seq | FBC)
                                  #IMPLIED
    PartPrefix       (Default-Part | Text-Part | None-Part | Numonly-Part)
                                  #IMPLIED
    ChapPrefix       (Default-Chap | Text-Chap | None-Chap | Numonly-Chap)
                                  #IMPLIED
    AppPrefix        (Default-App | Text-App | None-App | Numonly-App)
                                  #IMPLIED
    Classif          (Default-Classif | Lic | Res | ConfRes)
                                  #IMPLIED

    HyTime           NAME         #FIXED    HyDoc
    reftype          CDATA        #FIXED    'Rev Rev'
    unmspace         (unified | separate) #FIXED    "separate"

    InfoMast         NAME         #FIXED    "HierarchicalDivision"

    DTDVersion          CDATA           #FIXED   %DTDVersion;
>

