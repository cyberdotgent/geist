                               -- eliminated | graphic+ -->
<!ENTITY % tblexpt "-(Fn)" >
<!ENTITY % tblatt  "
  orient             (port|land)  #IMPLIED
  pgwide             %yesorno;    #IMPLIED
">
<!ENTITY % tblgrp  "colspec*, spanspec*, thead?, tfoot?, tbody" >
<!ENTITY % tblgrpatt ""        -- omits tgroupstyle -->
<!ENTITY % tblhdft "(thead | tfoot)"     -- eliminated " | tfoot" -->
<!ENTITY % tblhfmd "row+"      -- omits "colspec?, " before "row+" -->
<!ENTITY % tblhfex ""          -- no " -(entrytbl)" as not in %tblrow model -->
<!ENTITY % tblrow  "entry"     -- eliminated " | entrytbl" -->
<!ENTITY % tblrowex "" -- could exclude brk  -->
