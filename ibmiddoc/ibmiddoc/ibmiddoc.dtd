">
<!ENTITY % yesorno "NUMBER" >
<!ENTITY % titles  "(Cap?, Desc?)" >
<!ENTITY % paracon "%PhAndPLike.NoTab;" >

<!ENTITY % tblelm  "Table"     -- eliminated | chart -->
